@using Cinema.Models.ViewModel

@model RegisterVM
<div class="container py-4">
    <div >
            <div >
            <form method="post" class="actor-form" enctype="multipart/form-data">
                <div class="text-bg-danger" asp-validation-summary="All"> </div>
                <!-- Full Name -->
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="UserName" id="UserName" placeholder=" " required>
                    <label for="UserName">UserName</label>
                    <span asp-validation-for="UserName" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="Email" id="Email" placeholder=" " required>
                    <label for="Email">Email</label>
                    <span asp-validation-for="Email" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div> <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="Password" id="Password" placeholder=" " required>
                    <label for="Password">Password</label>
                    <span asp-validation-for="Password" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder=" " required>
                    <label for="ConfirmPassword">ConfirmPassword</label>
                    <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="Address" id="Address" placeholder=" " required>
                    <label for="Address">Address</label>
                    <span asp-validation-for="Address" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                <div class="form-actions">
                    <button type="submit" class="submit-btn">
                        <i class="fas fa-plus-circle"></i> Add Actor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
