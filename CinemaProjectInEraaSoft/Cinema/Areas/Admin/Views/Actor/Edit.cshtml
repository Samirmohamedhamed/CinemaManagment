@model Actor
<div class="container">
    <div class="row mb-3">
        <div class="col-6 d-flex align-items-center">
            <div class="display-6 mb-0">Create/Edit Actor</div>
        </div>
    </div>

    <div class="col-12 m-3">
        <form method="post" enctype="multipart/form-data" id="actorForm">
            <!-- Hidden field for Actor ID -->
            <input type="hidden" asp-for="Id" id="actorId" />

            <!-- Full Name -->
            <div class="mb-3">
                <label for="FullName" class="form-label">Full Name</label>
                <input type="text" class="form-control" asp-for="FullName">
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <!-- Nickname -->
            <div class="mb-3">
                <label for="Nickname" class="form-label">Nickname (Optional)</label>
                <input type="text" class="form-control" asp-for="Nickname">
                <span asp-validation-for="Nickname" class="text-danger"></span>
            </div>

            <!-- Date of Birth -->
            <div class="mb-3">
                <label for="DateOfBirth" class="form-label">Date of Birth</label>
                <input type="date" class="form-control" asp-for="DateOfBirth">
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <!-- Nationality -->
            <div class="mb-3">
                <label for="Nationality" class="form-label">Nationality</label>
                <input type="text" class="form-control" asp-for="Nationality">
                <span asp-validation-for="Nationality" class="text-danger"></span>
            </div>

            <!-- Gender -->
            <div class="mb-3">
                <label for="Gender" class="form-label">Gender</label>
                <select class="form-select" asp-for="Gender">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <!-- Biography -->
            <div class="mb-3">
                <label for="Biography" class="form-label">Biography (Optional)</label>
                <textarea class="form-control" asp-for="Biography" rows="3"></textarea>
                <span asp-validation-for="Biography" class="text-danger"></span>
            </div>
            <div class="form-group floating-label">
                <input type="file" class="form-control" asp-for="ImageUrl" id="ImageUrl" placeholder=" " name="MainImage">
                <label for="ImageUrl">Actor Image URL (Optional)</label>
                <span asp-validation-for="ImageUrl" class="validation-message"></span>
                <i class="fas fa-link input-icon"></i>
            </div>
            <!-- Actor Image Section -->
            <div class="mb-3">
                <label class="form-label">Actor Image</label>

                <!-- Hidden file input -->
                <input type="file" class="form-control" id="imageUpload" asp-for="ImageUrl" name="MainImage" style="display:none;">
                <span asp-validation-for="ImageUrl" class="text-danger"></span>

                <!-- Image Preview Container -->
                <div id="imagePreviewContainer" class="mt-3" style="@(Model?.ImageUrl != null ? "" : "display:none;")">
                    <img id="imagePreview" src="/image/@Model.ImageUrl" alt="Actor Image" class="img-thumbnail" style="max-height: 200px;">
                    <div class="mt-2">
                        <button type="button" id="removeImageBtn" class="btn btn-sm btn-outline-danger">Remove</button>
                    </div>
                </div>

                <!-- Upload Button (shown when no image exists) -->
                <button type="button" id="uploadImageBtn" class="btn btn-sm btn-primary mt-2" style="@(Model?.ImageUrl != null ? "display:none;" : "")">
                    Upload Image
                </button>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Handle upload button click
            $('#uploadImageBtn').click(function () {
                $('#imageUpload').click();
            });

            // Handle image selection
            $('#imageUpload').change(function () {
                if (this.files && this.files[0]) {
                    uploadImage(this.files[0]);
                }
            });

         

            // Handle remove button click
            $('#removeImageBtn').click(function () {
                if (confirm('Are you sure you want to remove this image?')) {
                    deleteImage();
                }
            });

           
            // Function to delete image
            function deleteImage() {
                $.ajax({
                    url: '/Admin/Actor/DeleteImage/@Model.Id',
                    type: 'POST',
                    data: { id: $('#actorId').val() },
                    success: function (response) {
                        if (response.success) {
                            $('#imagePreview').attr('src', '');
                            $('#imageUpload').val('');
                            $('#imagePreviewContainer').hide();
                            $('#uploadImageBtn').show();
                            // Clear model property if needed
                            $('#ImageUrl').val('');
                        }
                    },
                    error: function () {
                        alert('Error deleting image');
                    }
                });
            }

            // Show preview if image exists (for edit mode)
        @if (Model?.ImageUrl != null)
        {
            <text>
                        $('#imagePreviewContainer').show();
                        $('#uploadImageBtn').hide();
            </text>
        }
                });
    </script>
}