@model Actor

<div class="container py-4">
    <div class="cinema-form-container">
        <div class="cinema-form-header">
            <h1 class="cinema-form-title">
                <i class="fas fa-user"></i> Add New Actor
            </h1>
            <p class="cinema-form-subtitle">Please fill all required fields to register your actor</p>
        </div>

        <div class="actor-form-card">
            <form method="post" class="actor-form" enctype="multipart/form-data">
                <!-- Full Name -->
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="FullName" id="FullName" placeholder=" " required>
                    <label for="FullName">Full Name</label>
                    <span asp-validation-for="FullName" class="validation-message"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>

                <!-- Nickname -->
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="Nickname" id="Nickname" placeholder=" ">
                    <label for="Nickname">Nickname (Optional)</label>
                    <span asp-validation-for="Nickname" class="validation-message"></span>
                    <i class="fas fa-signature input-icon"></i>
                </div>

                <div class="row">
                    <!-- Date of Birth -->
                    <div class="col-md-6">
                        <div class="form-group floating-label">
                            <input type="date" class="form-control" asp-for="DateOfBirth" id="DateOfBirth" placeholder=" " required>
                            <label for="DateOfBirth">Date of Birth</label>
                            <span asp-validation-for="DateOfBirth" class="validation-message"></span>
                            <i class="fas fa-birthday-cake input-icon"></i>
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6">
                        <div class="form-group floating-label">
                            <select class="form-control" asp-for="Gender" id="Gender" required>
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <label for="Gender">Gender</label>
                            <span asp-validation-for="Gender" class="validation-message"></span>
                            <i class="fas fa-venus-mars input-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Nationality -->
                <div class="form-group floating-label">
                    <input type="text" class="form-control" asp-for="Nationality" id="Nationality" placeholder=" " required>
                    <label for="Nationality">Nationality</label>
                    <span asp-validation-for="Nationality" class="validation-message"></span>
                    <i class="fas fa-globe input-icon"></i>
                </div>

                <!-- Biography -->
                <div class="form-group floating-label">
                    <textarea class="form-control" asp-for="Biography" id="Biography" placeholder=" " rows="3"></textarea>
                    <label for="Biography">Biography (Optional)</label>
                    <span asp-validation-for="Biography" class="validation-message"></span>
                    <i class="fas fa-book input-icon"></i>
                </div>

                <!-- Actor Image URL -->
                <div class="form-group floating-label">
                    <input type="file" class="form-control" asp-for="ImageUrl" id="ImageUrl" placeholder=" " name="MainImage">
                    <label for="ImageUrl">Actor Image URL (Optional)</label>
                    <span asp-validation-for="ImageUrl" class="validation-message"></span>
                    <i class="fas fa-link input-icon"></i>
                </div>
             

                <div class="form-actions">
                    <button type="submit" class="submit-btn">
                        <i class="fas fa-plus-circle"></i> Add Actor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}