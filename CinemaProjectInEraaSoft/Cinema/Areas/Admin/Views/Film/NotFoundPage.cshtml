<section class="error-page bg-dark text-white py-5 min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">

                <!-- رقم الخطأ مع أيقونة -->
                <div class="error-code mb-4">
                    <span class="display-1 fw-bold d-inline-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-3"></i>404
                    </span>
                </div>

                <!-- رسالة الخطأ الرئيسية -->
                <h1 class="error-title mb-3">Page Not Found</h1>

                <!-- رسالة توضيحية -->
                <p class="lead mb-4">
                    The page you're looking for doesn't exist or has been moved.
                    <br>Please check the URL or navigate back to safety.
                </p>

                <!-- زر العودة -->
                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <a href="/Admin/Cinema/Index" class="btn btn-primary btn-lg px-4 gap-3">
                        <i class="fas fa-home me-2"></i>Back to Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-arrow-left me-2"></i>Go Back
                    </a>
                </div>

                <!-- رسالة إضافية -->
                <p class="mt-5 text-muted">
                    Need help? <a href="/contact" class="text-white">Contact our support team</a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/NotFoundBageStyle.css" asp-append-version="true" />

}