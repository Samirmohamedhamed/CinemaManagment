@model Film
<div class="container">
    <div class="row mb-3">
        <div class="col-6 d-flex align-items-center">
            <div class="display-6 mb-0">Create Film</div>
        </div>
    </div>

    <div class="col-12 m-3">
        <form method="post">

            <!-- Film Title -->
            <div class="mb-3">
                <label for="Title" class="form-label">Film Title</label>
                <input type="text" class="form-control" asp-for="Title" required>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="row">
                <!-- Release Date -->
                <div class="col-md-6 mb-3">
                    <label for="ReleaseDate" class="form-label">Release Date</label>
                    <input type="date" class="form-control" asp-for="ReleaseDate" required>
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <!-- Duration -->
                <div class="col-md-6 mb-3">
                    <label for="DurationInMinutes" class="form-label">Duration (minutes)</label>
                    <input type="number" class="form-control" asp-for="DurationInMinutes" required>
                    <span asp-validation-for="DurationInMinutes" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- Genre -->
                <div class="col-md-6 mb-3">
                    <label for="Genre" class="form-label">Genre</label>
                    <input type="text" class="form-control" asp-for="Genre" required>
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <!-- Rating -->
                <div class="col-md-6 mb-3">
                    <label for="Rating" class="form-label">Rating (Optional)</label>
                    <input type="text" class="form-control" asp-for="Rating">
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
            </div>

            <!-- Language -->
            <div class="mb-3">
                <label for="Language" class="form-label">Language</label>
                <input type="text" class="form-control" asp-for="Language" required>
                <span asp-validation-for="Language" class="text-danger"></span>
            </div>

            <!-- Cinema Select - Updated -->
            <div class="mb-3">
                <label class="form-label">Cinema</label>
                <select asp-for="CinemaaId" class="form-select" required>
                    <option value="" disabled selected>-- Select Cinema --</option>
                    @foreach (var cinema in ViewData["cinema"] as List<Cinemaa>)
                    {
                        <option value="@cinema.Id">@cinema.Name</option>
                    }
                </select>
                <span asp-validation-for="CinemaaId" class="text-danger"></span>
            </div>

            <!-- Actor Select - Updated -->
            <div class="mb-3">
                <label class="form-label">Actor</label>
                <select name="FilmActors[0].ActorId" class="form-select" required>
                    <option value="" disabled selected>-- Select Actor --</option>
                    @foreach (var actor in ViewData["actor"] as List<Actor>)
                    {
                        
                        <option value="@actor.Id">@actor.FullName</option>
                    }
                </select>
                <span class="text-danger" data-valmsg-for="FilmActors[0].ActorId"></span>
            </div>

            <!-- Budget -->
            <div class="mb-3">
                <label for="Budget" class="form-label">Budget (Optional)</label>
                <input type="number" step="0.01" class="form-control" asp-for="Budget">
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="Description" class="form-label">Description (Optional)</label>
                <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Poster URL -->
            <div class="mb-3">
                <label for="PosterUrl" class="form-label">Poster Image URL (Optional)</label>
                <input type="text" class="form-control" asp-for="PosterUrl" placeholder="Enter image URL">
                <span asp-validation-for="PosterUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
